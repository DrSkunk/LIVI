import { Theme, Ui } from "theme.slint";
import { Focus } from "focus.slint";

export enum Page { projection, telemetry, media, clock, camera, games, minidsp, settings }

export enum PhoneState { none, connected, streaming }

export struct SidebarClock {
    hour: string,
    minute: string,
    colon-visible: bool,
}

export struct TabData {
    page: Page,
    icon: image,
}

component ClockPart inherits Text {
    color: Theme.text;
    font-size: Ui.xs-icons ? 16px : 24px;
    letter-spacing: Theme.tracking;
    accessible-role: none;
}

component Tab inherits Rectangle {
    in property <Page> page;
    in property <image> icon;
    in property <bool> active;
    in property <bool> focused;
    in property <PhoneState> phone;
    in property <bool> enabled: true;
    in property <bool> right-hand;
    callback clicked();

    property <bool> cursor: touch.has-hover || root.focused;
    property <color> tint: page == Page.projection
        ? (phone == PhoneState.streaming ? Theme.highlight : phone == PhoneState.connected ? Theme.text : Theme.text-disabled)
        : root.active ? Theme.text : Theme.text-secondary;

    vertical-stretch: 1;
    min-height: Ui.icon-size;
    preferred-height: Ui.icon-size + (Ui.xs-icons ? 10px : 20px);

    // COMAND: a horizontal wash plus a glowing 2px bar on the outer edge marks
    // the selected tab; the others are muted.
    if Theme.comand && root.active: Rectangle {
        background: Theme.wash;
    }
    if Theme.comand && root.active: Rectangle {
        x: root.right-hand ? parent.width - 9px : 7px;
        y: parent.height * 0.2;
        width: 2px;
        height: parent.height * 0.6;
        background: Theme.highlight;
        drop-shadow-blur: 9px;
        drop-shadow-color: Theme.primary;
    }
    if !Theme.comand: Rectangle {
        width: min(Ui.icon-size + 16px, root.height);
        height: self.width;
        border-radius: 12px;
        background: root.active ? Theme.lit-pressed : touch.pressed ? Theme.lit : transparent;
        border-width: root.cursor ? 2px : 0;
        border-color: Theme.primary;
        animate background { duration: 120ms; }
    }

    Image {
        width: Ui.icon-size;
        height: Ui.icon-size;
        colorize: Theme.comand
            ? (root.cursor || root.active ? Theme.primary : root.page == Page.projection ? root.tint : Theme.muted)
            : (root.cursor ? Theme.primary : root.tint);
        opacity: Theme.comand
            ? (root.active || root.cursor || root.page == Page.projection ? 1 : 0.72)
            : (root.active || root.cursor || root.page == Page.projection ? 1 : 0.7);
        source: root.icon;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component Nav inherits Rectangle {
    in property <[TabData]> tabs;
    in property <Page> active;
    in property <PhoneState> phone;
    in property <SidebarClock> clock;
    in property <bool> right-hand;
    in property <bool> asleep;
    callback select(Page);

    property <length> clock-pair-width: root.clock.hour == "" && root.clock.minute == ""
        ? 0px : max(clock-pair-probe.preferred-width, max(clock-hours.preferred-width, clock-minutes.preferred-width));
    width: Ui.xs-icons ? Ui.nav-width : max(Ui.icon-size + 16px, Ui.show-clock ? clock-text.preferred-width : 0) + 2 * Ui.nav-pad + 1px;
    background: Theme.comand ? Theme.nav-fill : Theme.background;
    drop-shadow-blur: Theme.comand ? 25px : 0;
    drop-shadow-offset-x: root.right-hand ? -8px : 8px;
    drop-shadow-color: Theme.nav-shadow;
    opacity: root.asleep ? 0 : 1;
    animate opacity { duration: 220ms; easing: ease; }

    VerticalLayout {
        Rectangle {
            visible: Ui.show-clock;
            height: Ui.show-clock ? clock-text.preferred-height + 16px : 0;
            accessible-role: text;
            accessible-label: root.clock.hour == "" && root.clock.minute == ""
                ? "" : root.clock.hour + ":" + root.clock.minute;
            // 8 is among the widest digits in both bundled UI fonts.
            clock-pair-probe := ClockPart {
                text: "88";
                opacity: 0;
            }
            clock-text := HorizontalLayout {
                x: (parent.width - self.width) / 2;
                y: 16px;
                width: self.preferred-width;
                height: self.preferred-height;
                clock-hours := ClockPart {
                    width: root.clock-pair-width;
                    text: root.clock.hour;
                    horizontal-alignment: right;
                }
                ClockPart {
                    text: ":";
                    opacity: root.clock.colon-visible ? 1 : 0;
                }
                clock-minutes := ClockPart {
                    width: root.clock-pair-width;
                    text: root.clock.minute;
                    horizontal-alignment: left;
                }
            }
        }
        for tab[i] in root.tabs: Tab {
            page: tab.page;
            icon: tab.icon;
            focused: Focus.nav(i);
            active: tab.page == root.active;
            phone: root.phone;
            right-hand: root.right-hand;
            enabled: !root.asleep;
            clicked => { root.select(tab.page); }
        }
        if root.tabs.length == 0: Rectangle { vertical-stretch: 1; }
    }

    Rectangle {
        x: root.right-hand ? 0 : parent.width - 1px;
        width: 1px;
        background: Theme.comand ? Theme.rule : Theme.hairline;
    }
    if Theme.comand: Rectangle {
        x: root.right-hand ? 1px : parent.width - 2px;
        width: 1px;
        background: Theme.nav-edge;
    }
}
