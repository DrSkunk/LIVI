Description: v4l2codecs: opt in to legacy Raspberry Pi HEVC slice lengths
 The pinned LIVI OS 6.12 rpi-hevc-dec driver treats bit_size as the end of
 slice data relative to the queued buffer and subtracts data_byte_offset.
 Newer drivers treat bit_size as the payload length. Preserve the modern
 default, with an explicit compatibility flag for the pinned appliance.
 Include preceding slices in the legacy end offset for frame-based decoding.
Author: LIVI contributors
Forwarded: no
---
--- a/sys/v4l2codecs/gstv4l2codech265dec.c
+++ b/sys/v4l2codecs/gstv4l2codech265dec.c
@@ -735,7 +735,10 @@
   params = &g_array_index (self->slice_params, struct v4l2_ctrl_hevc_slice_params, n);
   *params = (struct v4l2_ctrl_hevc_slice_params) {
-    .bit_size = (slice_size - get_slice_header_byte_offset(slice)) * 8,
+    .bit_size =
+        g_strcmp0 (g_getenv ("LIVI_GST_HEVC_LEGACY_SLICE"), "1") == 0 ?
+        (self->bitstream_map.size + slice_size + sc_offset) * 8 :
+        (slice_size - get_slice_header_byte_offset(slice)) * 8,
     .data_byte_offset = get_slice_header_byte_offset (slice) + sc_offset + self->bitstream_map.size,
     .num_entry_point_offsets = slice_hdr->num_entry_point_offsets,
     .nal_unit_type = slice->nalu.type,
     .nuh_temporal_id_plus1 = slice->nalu.temporal_id_plus1,
